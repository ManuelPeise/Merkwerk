# Line endings: Git defaults (core.autocrlf from the Git for Windows setup).
# Only mark binary files so Git never tries to convert them.
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.webp  binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.mp3   binary
*.wav   binary
*.pdf   binary
