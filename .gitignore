# =====================================================================
#  .gitignore – Lernplattform (.NET 10, Blazor, MySQL, Docker, später Expo)
# =====================================================================

# ---------------------------------------------------------------------
# .NET Build-Ausgaben
# ---------------------------------------------------------------------
[Bb]in/
[Oo]bj/
[Dd]ebug/
[Rr]elease/
x64/
x86/
[Aa]rm/
[Aa]rm64/
bld/
[Ll]og/
[Ll]ogs/
artifacts/
publish/
*.nupkg
*.snupkg
# NuGet-Pakete werden wiederhergestellt, nicht eingecheckt
**/[Pp]ackages/*
!**/[Pp]ackages/build/
project.lock.json
project.fragment.lock.json

# EF Core Migrations-Bundle (wird in der CI gebaut)
efbundle
efbundle.exe

# ---------------------------------------------------------------------
# Blazor / WebAssembly / PWA
# ---------------------------------------------------------------------
**/wwwroot/_framework/
**/wwwroot/_content/
# Aus den Design Tokens generierte Dateien (Quelle: shared/design-tokens/tokens.json)
**/wwwroot/css/tokens.generated.css
**/*.generated.css

# ---------------------------------------------------------------------
# Tests, Coverage, Playwright
# ---------------------------------------------------------------------
[Tt]est[Rr]esult*/
TestResults/
*.trx
coverage/
coverage*.json
coverage*.xml
coverage*.info
*.coverage
*.coveragexml
playwright-report/
test-results/
.playwright/

# ---------------------------------------------------------------------
# Geheimnisse und lokale Konfiguration – NIE einchecken
# ---------------------------------------------------------------------
.env
.env.*
!.env.example
appsettings.*.local.json
appsettings.Local.json
secrets.json
*.pfx
*.p12
*.key
*.pem
!**/testdata/**/*.pem

# ---------------------------------------------------------------------
# Docker / lokale Datenbank / Uploads
# ---------------------------------------------------------------------
deploy/data/
deploy/backups/
deploy/caddy-data/
mysql-data/
*.sql.gz
*.dump
# Hochgeladene Bilder/Audios der lokalen Instanz
deploy/uploads/
**/wwwroot/uploads/

