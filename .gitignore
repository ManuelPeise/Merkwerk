_ReSharper*/
*.[Rr]e[Ss]harper
*.DotSettings.user
launchSettings.local.json

# ---------------------------------------------------------------------
# JetBrains Rider
# ---------------------------------------------------------------------
.idea/
*.sln.iml

# ---------------------------------------------------------------------
# Visual Studio Code (gemeinsame Einstellungen bleiben drin)
# ---------------------------------------------------------------------
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace
.history/

# ---------------------------------------------------------------------
# Node / Expo (später: clients/kids-app) und Design-Token-Build
# ---------------------------------------------------------------------
node_modules/
.pnpm-store/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.expo/
.expo-shared/
dist/
web-build/
*.jks
*.p8
*.mobileprovision
*.orig.*
ios/Pods/
android/.gradle/
android/app/build/

# ---------------------------------------------------------------------
# ML-Modelle (falls später ML.NET/ONNX: große Dateien nicht ins Repo)
# ---------------------------------------------------------------------
*.onnx
models/*.zip

# ---------------------------------------------------------------------
# Betriebssysteme
# ---------------------------------------------------------------------
