# Copy to deploy/.env and replace every value. Never commit .env.

# Host name the tablets use, e.g. merkwerk.local or the Pi's IP address
MERKWERK_HOST=merkwerk.local

# Container images (GitHub user/org and version tag)
GHCR_OWNER=manuelpeise
APP_VERSION=latest

# Database
DB_NAME=merkwerk
DB_USER=merkwerk
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-too
DB_BUFFER_POOL=512M

# JWT signing key: at least 32 random characters
#   PowerShell: [Convert]::ToBase64String((1..48 | % { Get-Random -Max 256 }))
JWT_SIGNING_KEY=change-me-to-a-long-random-string

# Mail (SMTP of your mail provider). Links in mails use https://MERKWERK_HOST
MAIL_HOST=smtp.example.org
MAIL_PORT=587
# None | StartTls | SslOnConnect
MAIL_SECURITY=StartTls
MAIL_USER=merkwerk@example.org
MAIL_PASSWORD=change-me
MAIL_FROM=merkwerk@example.org

# Development only (proxy-dev): IP address or host name of your PC on the home network,
# e.g. 192.168.178.20 - tablets open https://<DEV_HOST>:8443/ueben
DEV_HOST=localhost
