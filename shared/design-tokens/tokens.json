{
  "$description": "Merkwerk design tokens - direction A 'calm learning space' (decided in LP-008, 02.10.2026). Format: W3C Design Tokens (DTCG). Generated CSS: sources/Web.Client/wwwroot/css/tokens.css (see README).",
  "color": {
    "brand": {
      "primary":        { "$type": "color", "$value": "#1F6F78", "$description": "buttons, links, focus; white text 5.8:1" },
      "primary-strong": { "$type": "color", "$value": "#174F56", "$description": "hover/pressed, text on primary-soft" },
      "primary-soft":   { "$type": "color", "$value": "#DCEBEC", "$description": "soft buttons, avatar background" },
      "star":           { "$type": "color", "$value": "#E2A33B", "$description": "reward star, decorative only (always next to a number)" }
    },
    "surface": {
      "background": { "$type": "color", "$value": "#FAF8F4" },
      "card":       { "$type": "color", "$value": "#FFFFFF" },
      "muted":      { "$type": "color", "$value": "#F1EDE6", "$description": "secondary keys, disabled areas" },
      "track":      { "$type": "color", "$value": "#EEE9E0", "$description": "progress bar track" }
    },
    "border": {
      "subtle": { "$type": "color", "$value": "#E3DED5", "$description": "card outlines (decorative)" },
      "strong": { "$type": "color", "$value": "#6E8F92", "$description": "input and answer boxes; 3.5:1 on card" }
    },
    "text": {
      "primary":    { "$type": "color", "$value": "#1E2328", "$description": "14.9:1 on background" },
      "secondary":  { "$type": "color", "$value": "#5B636B", "$description": "5.8:1 on background" },
      "on-primary": { "$type": "color", "$value": "#FFFFFF" }
    },
    "subject": {
      "german":  { "$type": "color", "$value": "#C0504D", "$description": "Deutsch; white icon/text 4.7:1" },
      "english": { "$type": "color", "$value": "#3A75A8", "$description": "Englisch; white icon/text 4.9:1" },
      "math":    { "$type": "color", "$value": "#3B7F49", "$description": "Mathe; white icon/text 4.9:1" },
      "purple":  { "$type": "color", "$value": "#7A4FA3", "$description": "further subjects (LP-109); white icon/text 6.0:1" },
      "orange":  { "$type": "color", "$value": "#A3560F", "$description": "further subjects (LP-109); white icon/text 5.4:1" },
      "magenta": { "$type": "color", "$value": "#A8336C", "$description": "further subjects (LP-109); white icon/text 6.3:1" },
      "slate":   { "$type": "color", "$value": "#51606E", "$description": "further subjects (LP-109); white icon/text 6.5:1" },
      "olive":   { "$type": "color", "$value": "#5E6B1E", "$description": "further subjects (LP-109); white icon/text 5.8:1" }
    },
    "feedback": {
      "correct":    { "$type": "color", "$value": "#1E6B43", "$description": "text/icon, always with a check icon; 5.7:1 on correct-bg" },
      "correct-bg": { "$type": "color", "$value": "#E6F4EC" },
      "retry":      { "$type": "color", "$value": "#8A4B0F", "$description": "friendly 'try again', never harsh red; always with a retry icon; 6.1:1 on retry-bg" },
      "retry-bg":   { "$type": "color", "$value": "#FFF1E0" }
    },
    "part-of-speech": {
      "noun":      { "$type": "color", "$value": "#2F6FD0", "$description": "4.9:1 on white" },
      "verb":      { "$type": "color", "$value": "#C23A27", "$description": "5.4:1 on white" },
      "adjective": { "$type": "color", "$value": "#23803F", "$description": "5.0:1 on white" }
    }
  },
  "font": {
    "family": {
      "kids":  { "$type": "fontFamily", "$value": ["Andika", "Segoe UI", "sans-serif"], "$description": "self-hosted (wwwroot/fonts/andika), designed for beginning readers" },
      "adult": { "$type": "fontFamily", "$value": ["system-ui", "Segoe UI", "Roboto", "sans-serif"], "$description": "system fonts, nothing to download" }
    },
    "weight": {
      "regular": { "$type": "fontWeight", "$value": 400 },
      "bold":    { "$type": "fontWeight", "$value": 700 }
    },
    "size": {
      "kids-small":   { "$type": "dimension", "$value": "20px" },
      "kids-body":    { "$type": "dimension", "$value": "22px" },
      "kids-heading": { "$type": "dimension", "$value": "28px" },
      "kids-title":   { "$type": "dimension", "$value": "40px" },
      "kids-key":     { "$type": "dimension", "$value": "40px" },
      "kids-display": { "$type": "dimension", "$value": "88px", "$description": "the exercise itself, e.g. 7 + 5" },
      "adult-body":   { "$type": "dimension", "$value": "15px" },
      "adult-heading":{ "$type": "dimension", "$value": "22px" }
    }
  },
  "space": {
    "xs":  { "$type": "dimension", "$value": "4px" },
    "s":   { "$type": "dimension", "$value": "8px" },
    "m":   { "$type": "dimension", "$value": "16px" },
    "l":   { "$type": "dimension", "$value": "24px" },
    "xl":  { "$type": "dimension", "$value": "32px" },
    "xxl": { "$type": "dimension", "$value": "48px" }
  },
  "size": {
    "touch-target-min": { "$type": "dimension", "$value": "64px" },
    "key":              { "$type": "dimension", "$value": "96px", "$description": "on-screen keypad key height" },
    "icon-chip":        { "$type": "dimension", "$value": "64px" }
  },
  "radius": {
    "s":    { "$type": "dimension", "$value": "6px" },
    "m":    { "$type": "dimension", "$value": "12px" },
    "l":    { "$type": "dimension", "$value": "20px" },
    "xl":   { "$type": "dimension", "$value": "24px" },
    "pill": { "$type": "dimension", "$value": "999px" }
  },
  "border-width": {
    "default": { "$type": "dimension", "$value": "2px" },
    "answer":  { "$type": "dimension", "$value": "3px" }
  }
}
