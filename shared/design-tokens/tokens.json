{
  "$description": "Merkwerk design tokens – DRAFT. Values are placeholders for design direction A ('calm learning space') until LP-008 decides. Format: W3C Design Tokens (DTCG).",
  "color": {
    "brand": {
      "primary":   { "$type": "color", "$value": "#1F6F78" },
      "secondary": { "$type": "color", "$value": "#F2A65A" }
    },
    "surface": {
      "background": { "$type": "color", "$value": "#FAF8F4" },
      "card":       { "$type": "color", "$value": "#FFFFFF" },
      "border":     { "$type": "color", "$value": "#E3DED5" }
    },
    "text": {
      "primary":   { "$type": "color", "$value": "#1E2328" },
      "secondary": { "$type": "color", "$value": "#5B636B" }
    },
    "subject": {
      "german":  { "$type": "color", "$value": "#C0504D", "$description": "Deutsch" },
      "english": { "$type": "color", "$value": "#3E7CB1", "$description": "Englisch" },
      "math":    { "$type": "color", "$value": "#4E9A5B", "$description": "Mathe" }
    },
    "feedback": {
      "correct": { "$type": "color", "$value": "#2E8B57", "$description": "always combined with a check icon" },
      "retry":   { "$type": "color", "$value": "#E08A2E", "$description": "friendly 'try again', never harsh red" }
    },
    "partOfSpeech": {
      "noun":      { "$type": "color", "$value": "#2F6FD0" },
      "verb":      { "$type": "color", "$value": "#D0442F" },
      "adjective": { "$type": "color", "$value": "#2F9E4F" }
    }
  },
  "font": {
    "family": {
      "base":     { "$type": "fontFamily", "$value": ["Andika", "Segoe UI", "sans-serif"] },
      "adult":    { "$type": "fontFamily", "$value": ["Inter", "Segoe UI", "sans-serif"] }
    },
    "size": {
      "kids-body":  { "$type": "dimension", "$value": "22px" },
      "kids-title": { "$type": "dimension", "$value": "30px" },
      "adult-body": { "$type": "dimension", "$value": "15px" }
    }
  },
  "space": {
    "xs": { "$type": "dimension", "$value": "4px" },
    "s":  { "$type": "dimension", "$value": "8px" },
    "m":  { "$type": "dimension", "$value": "16px" },
    "l":  { "$type": "dimension", "$value": "24px" },
    "xl": { "$type": "dimension", "$value": "40px" }
  },
  "size": {
    "touch-target-min": { "$type": "dimension", "$value": "64px" }
  },
  "radius": {
    "s": { "$type": "dimension", "$value": "6px" },
    "m": { "$type": "dimension", "$value": "12px" },
    "l": { "$type": "dimension", "$value": "20px" }
  }
}
