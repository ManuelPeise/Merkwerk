<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="coverlet.collector" />
  </ItemGroup>

  <!-- Every production project, so the rules can inspect their assemblies (no extra package, plain reflection). -->
  <ItemGroup>
    <ProjectReference Include="..\Web.Core\Web.Core.csproj" />
    <ProjectReference Include="..\Logic.Authentication\Logic.Authentication.csproj" />
    <ProjectReference Include="..\Logic.Content\Logic.Content.csproj" />
    <ProjectReference Include="..\Logic.Devices\Logic.Devices.csproj" />
    <ProjectReference Include="..\Logic.Notifications\Logic.Notifications.csproj" />
    <ProjectReference Include="..\Logic.Organizations\Logic.Organizations.csproj" />
    <ProjectReference Include="..\Logic.Shared\Logic.Shared.csproj" />
    <ProjectReference Include="..\Data.Accessor\Data.Accessor.csproj" />
    <ProjectReference Include="..\Data.Database\Data.Database.csproj" />
    <ProjectReference Include="..\Shared\Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <!-- Design tokens for the subject color check (LP-109). -->
  <ItemGroup>
    <None Include="..\..\shared\design-tokens\tokens.json" Link="DesignTokens\tokens.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
