<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="coverlet.collector" />
    <!-- Subjects (later exercises) against a real MySQL 8.4 (needs Docker). -->
    <PackageReference Include="Testcontainers.MySql" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Logic.Content\Logic.Content.csproj" />
    <!-- IMemberService comes from Logic.Organizations, exactly as in the app. -->
    <ProjectReference Include="..\Logic.Organizations\Logic.Organizations.csproj" />
    <!-- Only for AddMerkwerkIdentity: the tests use exactly the Identity rules of the app. -->
    <ProjectReference Include="..\Web.Core\Web.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <!-- Grading cases shared with a later client-side grader (LP-111). -->
  <ItemGroup>
    <None Include="..\..\shared\grading-cases\**\*.json" LinkBase="GradingCases" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
