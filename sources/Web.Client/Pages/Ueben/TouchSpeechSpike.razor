@page "/ueben/spike"
@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: false))
@implements IAsyncDisposable
@inject DragDropService DragDrop
@inject SpeechService Speech
@inject IJSRuntime JS
@using System.Globalization

@* LP-007 spike: drag & drop by finger (SortableJS) and read-aloud (Web Speech API) on real Android devices.
   Temporary texts and colours, not localised and not using design tokens yet. *@
<PageTitle>Ziehen &amp; Vorlesen – Merkwerk</PageTitle>

<div class="spike">
    <h1>Ziehen &amp; Vorlesen</h1>
    <p class="device">@_device</p>

    <section>
        <h2>1 · Zuordnen</h2>
        <p>Ziehe jedes englische Wort zum passenden deutschen Wort. Kurz antippen = vorlesen.</p>

        <div class="zone pool" data-zone="pool" @ref="_poolElement">
            @foreach (var card in _zones["pool"])
            {
                <div class="card" data-id="@card.Id" @key="card.Id" @onclick="() => ReadCardAsync(card)">@card.Text</div>
            }
        </div>

        <div class="targets">
            @foreach (var target in _targets)
            {
                var state = TargetState(target);
                <div class="target">
                    <span class="label">@target.Label</span>
                    <div class="zone drop @state" data-zone="@target.Zone" @ref="target.Element">
                        @foreach (var card in _zones[target.Zone])
                        {
                            <div class="card" data-id="@card.Id" @key="card.Id" @onclick="() => ReadCardAsync(card)">@card.Text</div>
                        }
                    </div>
                    <span class="feedback" aria-live="polite">
                        @if (state == "right")
                        {
                            <span>✓ Richtig</span>
                        }
                        else if (state == "wrong")
                        {
                            <span>↺ Nochmal</span>
                        }
                    </span>
                </div>
            }
        </div>
    </section>

    <section>
        <h2>2 · Reihenfolge</h2>
        <p>Bring die Silben in die richtige Reihenfolge.</p>
        <div class="zone row @(IsOrderRight ? "right" : null)" data-zone="order" @ref="_orderElement">
            @foreach (var card in _zones["order"])
            {
                <div class="card" data-id="@card.Id" @key="card.Id">@card.Text</div>
            }
        </div>
        <p class="feedback">@(IsOrderRight ? "✓ Schmetterling!" : string.Empty)</p>
    </section>

    <button class="big-button" @onclick="Reset">Neu mischen</button>
    <p><small>Ablagen: @_drops · letzte: @_lastDrop</small></p>

    <section>
        <h2>3 · Vorlesen</h2>
        @if (_speechSupported is false)
        {
            <p class="bad">✗ Dieser Browser unterstützt keine Sprachausgabe.</p>
        }
        else
        {
            <p>Stimmen: @_voices.Count gesamt · Deutsch: @VoicesFor("de").Count() · Englisch: @VoicesFor("en").Count()</p>

            <label>
                Tempo
                <select @bind="_rate">
                    <option value="0.7">langsam (0.7)</option>
                    <option value="0.85">etwas langsamer (0.85)</option>
                    <option value="1">normal (1.0)</option>
                </select>
            </label>

            <div class="speak">
                <label>
                    Deutsche Stimme
                    <select @bind="_germanVoice">
                        <option value="">Standard (de-DE)</option>
                        @foreach (var voice in VoicesFor("de"))
                        {
                            <option value="@voice.VoiceUri">@VoiceLabel(voice)</option>
                        }
                    </select>
                </label>
                <textarea @bind="_germanText" rows="2"></textarea>
                <button class="big-button" @onclick="() => SpeakAsync(_germanText, GermanLang, _germanVoice)">🔊 Deutsch</button>
            </div>

            <div class="speak">
                <label>
                    Englische Stimme
                    <select @bind="_englishVoice">
                        <option value="">Standard (en-GB)</option>
                        @foreach (var voice in VoicesFor("en"))
                        {
                            <option value="@voice.VoiceUri">@VoiceLabel(voice)</option>
                        }
                    </select>
                </label>
                <textarea @bind="_englishText" rows="2"></textarea>
                <button class="big-button" @onclick="() => SpeakAsync(_englishText, EnglishLang, _englishVoice)">🔊 Englisch</button>
            </div>

            <button class="big-button secondary" @onclick="() => Speech.CancelAsync()">■ Stopp</button>
            <p role="status">@_speechResult</p>

            <details>
                <summary>Alle Stimmen (@_voices.Count)</summary>
                <ul>
                    @foreach (var voice in _voices)
                    {
                        <li>@voice.Lang · @VoiceLabel(voice)</li>
                    }
                </ul>
            </details>
        }
    </section>

    <p><a href="ueben">Zurück</a></p>
</div>

@code {
    private const string GermanLang = "de-DE";
    private const string EnglishLang = "en-GB";
    private const string OrderSolution = "Schmet|ter|ling";

    private readonly Dictionary<string, List<Card>> _zones = new();
    private readonly List<Target> _targets =
    [
        new("Hund", "t-dog", "dog"),
        new("Katze", "t-cat", "cat"),
        new("Haus", "t-house", "house"),
    ];

    private readonly List<IAsyncDisposable> _attachments = [];
    private ElementReference _poolElement;
    private ElementReference _orderElement;
    private int _drops;
    private string _lastDrop = "–";

    private string _device = string.Empty;
    private bool? _speechSupported;
    private IReadOnlyList<SpeechVoice> _voices = [];
    private string _germanVoice = string.Empty;
    private string _englishVoice = string.Empty;
    // string, not double: the browser culture (de) would parse "0.85" as 85.
    private string _rate = "0.85";
    private string _germanText = "Der Hund spielt im Garten. Wie viele Äpfel liegen im Korb?";
    private string _englishText = "The cat is sleeping on the sofa. What colour is the house?";
    private string _speechResult = string.Empty;

    private bool IsOrderRight => string.Join('|', _zones["order"].Select(c => c.Text)) == OrderSolution;

    protected override void OnInitialized() => Reset();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        var match = new DragDropOptions("match", AllowSort: false);
        _attachments.Add(await DragDrop.AttachAsync(_poolElement, match, OnDropAsync));
        foreach (var target in _targets)
        {
            _attachments.Add(await DragDrop.AttachAsync(target.Element, match, OnDropAsync));
        }

        _attachments.Add(await DragDrop.AttachAsync(_orderElement, new DragDropOptions("order", AllowSort: true), OnDropAsync));

        await using (var metrics = await JS.InvokeAsync<IJSObjectReference>("import", "./js/metrics.js"))
        {
            var info = await metrics.InvokeAsync<DeviceInfo>("deviceInfo");
            _device = $"{info.Screen} · Touchpunkte {info.MaxTouchPoints} · als App: {(info.Standalone ? "ja" : "nein")} · {info.UserAgent}";
        }

        _speechSupported = await Speech.IsSupportedAsync();
        if (_speechSupported == true)
        {
            _voices = await Speech.GetVoicesAsync();
        }

        StateHasChanged();
    }

    private void Reset()
    {
        _zones["pool"] = Shuffle([new("c-dog", "dog"), new("c-cat", "cat"), new("c-house", "house")]);
        foreach (var target in _targets)
        {
            _zones[target.Zone] = [];
        }

        _zones["order"] = Shuffle([new("s-1", "Schmet"), new("s-2", "ter"), new("s-3", "ling")]);
        if (IsOrderRight)
        {
            _zones["order"].Reverse();
        }
    }

    private Task OnDropAsync(DropEvent drop)
    {
        var from = _zones[drop.FromZone];
        var card = from.Single(c => c.Id == drop.ItemId);
        from.Remove(card);

        var to = _zones[drop.ToZone];
        to.Insert(Math.Clamp(drop.NewIndex, 0, to.Count), card);

        _drops++;
        _lastDrop = $"{card.Text}: {drop.FromZone} → {drop.ToZone} @ {drop.NewIndex}";
        return InvokeAsync(StateHasChanged);
    }

    private string? TargetState(Target target)
    {
        var cards = _zones[target.Zone];
        if (cards.Count == 0)
        {
            return null;
        }

        return cards.Count == 1 && cards[0].Text == target.Answer ? "right" : "wrong";
    }

    private Task ReadCardAsync(Card card) => SpeakAsync(card.Text, EnglishLang, _englishVoice);

    private async Task SpeakAsync(string text, string lang, string voiceUri)
    {
        _speechResult = "…";
        var rate = double.Parse(_rate, CultureInfo.InvariantCulture);
        var result = await Speech.SpeakAsync(text, lang, string.IsNullOrEmpty(voiceUri) ? null : voiceUri, rate);

        var voice = result.VoiceName ?? $"Standard {lang}";
        _speechResult = result.Ok
            ? $"✓ {voice} · Start nach {result.StartDelayMs:0} ms · Dauer {result.DurationMs / 1000:0.0} s"
            : $"✗ {voice} · Fehler: {result.Error}" + (result.StartDelayMs is null ? string.Empty : $" · Start nach {result.StartDelayMs:0} ms");
    }

    private IEnumerable<SpeechVoice> VoicesFor(string language) =>
        _voices.Where(v => v.Lang.StartsWith(language, StringComparison.OrdinalIgnoreCase)).OrderBy(v => v.Lang).ThenBy(v => v.Name);

    private static string VoiceLabel(SpeechVoice voice) =>
        $"{voice.Name}{(voice.LocalService ? string.Empty : " (online)")}{(voice.IsDefault ? " ★" : string.Empty)}";

    private static List<Card> Shuffle(List<Card> cards) => cards.OrderBy(_ => Random.Shared.Next()).ToList();

    public async ValueTask DisposeAsync()
    {
        foreach (var attachment in _attachments)
        {
            await attachment.DisposeAsync();
        }

        await Speech.CancelAsync();
    }

    private sealed record Card(string Id, string Text);

    private sealed class Target(string label, string zone, string answer)
    {
        public string Label { get; } = label;
        public string Zone { get; } = zone;
        public string Answer { get; } = answer;
        public ElementReference Element { get; set; }
    }

    public sealed record DeviceInfo(string UserAgent, string Screen, int MaxTouchPoints, bool Standalone);
}
