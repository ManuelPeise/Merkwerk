@page "/ueben"
@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: false))
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject HttpClient Http
@inject RefreshingHandler RefreshHandler

@* LP-005/LP-006 spike: proves the children's area runs in WebAssembly, measures load time,
   lists the assemblies loaded in the browser and calls the API with the JWT cookie.
   Temporary texts, not localised yet. *@
<PageTitle>Üben – Merkwerk</PageTitle>

<div class="kids">
    <h1>Hallo!</h1>

    <p>Renderer: <strong>@RendererInfo.Name</strong> · interaktiv: <strong>@RendererInfo.IsInteractive</strong></p>
    <p>Erwartet: <code>WebAssembly</code> – die Seite läuft komplett im Browser.</p>

    <p>
        Bereit nach
        <strong>@(_readyMs is null ? "…" : $"{_readyMs.Value:0} ms")</strong>
        seit Seitenaufruf
        <small>(Seite direkt öffnen oder neu laden, nicht über einen Link)</small>
    </p>

    <button class="big-button" @onclick="() => _taps++">Tippen! (@_taps)</button>

    <p class="@(_forbidden.Count == 0 ? "ok" : "bad")">
        @if (_forbidden.Count == 0)
        {
            <span>✓ Kein EF Core, Logic oder Data.* im Browser geladen</span>
        }
        else
        {
            <span>✗ Verbotene Assemblies geladen: @string.Join(", ", _forbidden)</span>
        }
    </p>

    <h2>API-Aufruf mit JWT-Cookie (LP-006)</h2>
    <button class="big-button" @onclick="CallApiAsync">Wer bin ich?</button>
    <p role="status">@_apiResult</p>
    <p><small>Token erneuert: @RefreshHandler.RefreshCount × · Test: anmelden, mehr als 1 Minute warten, erneut tippen.</small></p>

    <details>
        <summary>Geladene Assemblies (@_assemblies.Count)</summary>
        <ul>
            @foreach (var name in _assemblies)
            {
                <li>@name</li>
            }
        </ul>
    </details>

    <p><a href="admin">Zum Erwachsenen-Bereich</a> · <a href="/">Start</a></p>
</div>

@code {
    private int _taps;
    private double? _readyMs;
    private List<string> _assemblies = [];
    private List<string> _forbidden = [];
    private IJSObjectReference? _metrics;
    private string _apiResult = string.Empty;

    protected override void OnInitialized()
    {
        _assemblies = AppDomain.CurrentDomain.GetAssemblies()
            .Select(a => a.GetName().Name ?? "?")
            .Order()
            .ToList();

        _forbidden = _assemblies
            .Where(n => n.Contains("EntityFrameworkCore", StringComparison.Ordinal)
                        || n.StartsWith("Data.", StringComparison.Ordinal)
                        || n == "Logic")
            .ToList();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        _metrics = await JS.InvokeAsync<IJSObjectReference>("import", "./js/metrics.js");
        _readyMs = await _metrics.InvokeAsync<double>("msSinceNavigationStart");
        StateHasChanged();
    }

    private async Task CallApiAsync()
    {
        _apiResult = "…";
        var response = await Http.GetAsync("api/v1/auth/me");
        if (response.IsSuccessStatusCode)
        {
            var session = await response.Content.ReadFromJsonAsync<SessionInfo>();
            var validUntil = session is null ? "?" : session.AccessTokenExpiresAt.ToLocalTime().ToString("HH:mm:ss");
            _apiResult = $"{session?.Name} ({session?.Role}), Token gültig bis {validUntil}";
        }
        else
        {
            _apiResult = $"Nicht angemeldet ({(int)response.StatusCode})";
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_metrics is not null)
        {
            await _metrics.DisposeAsync();
        }
    }
}
