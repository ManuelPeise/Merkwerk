<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Same id as the former Web project: the existing user secrets (connection string, JWT signing key) keep working. -->
    <UserSecretsId>merkwerk-web-bfb089d1-2e28-4055-a8a6-9ed9be70cbdc</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Logic.Authentication\Logic.Authentication.csproj" />
    <ProjectReference Include="..\Logic.Content\Logic.Content.csproj" />
    <ProjectReference Include="..\Logic.Devices\Logic.Devices.csproj" />
    <ProjectReference Include="..\Logic.Notifications\Logic.Notifications.csproj" />
    <ProjectReference Include="..\Logic.Organizations\Logic.Organizations.csproj" />
    <ProjectReference Include="..\Logic.Shared\Logic.Shared.csproj" />
    <ProjectReference Include="..\Shared\Shared.csproj" />
    <!-- Data.Accessor / Data.Database only for DI registration and ICurrentUser (AGENTS.md §3). -->
    <ProjectReference Include="..\Data.Accessor\Data.Accessor.csproj" />
    <ProjectReference Include="..\Data.Database\Data.Database.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Swashbuckle.AspNetCore.SwaggerUI" />
    <!-- dotnet ef (migrations with -s Web.Core); not part of the published app. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Services\Attributes\" />
  </ItemGroup>

</Project>
