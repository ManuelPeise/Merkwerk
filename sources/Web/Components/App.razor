@inject IWebHostEnvironment Environment
@inject IConfiguration Configuration
<!DOCTYPE html>
<html lang="de">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <meta name="theme-color" content="#1F6F78" />
    <link rel="manifest" href="manifest.webmanifest" />
    <link rel="icon" type="image/png" href="icons/icon-192.png" />
    <link rel="apple-touch-icon" href="icons/icon-192.png" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <ResourcePreloader />
    @* Design tokens and the Andika font live in Web.Client (served at the site root) – LP-008 *@
    <link rel="stylesheet" href="@Assets["css/fonts.css"]" />
    <link rel="stylesheet" href="@Assets["css/tokens.css"]" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["Web.styles.css"]" />
    <ImportMap />
    <HeadOutlet />
</head>

<body>
    <Routes />
    <ReconnectModal />
    <script src="@Assets["_framework/blazor.web.js"]"></script>
    <script src="@Assets["js/auth-spike.js"]"></script>
    @if (!Environment.IsDevelopment() || Configuration.GetValue<bool>("Pwa:EnableServiceWorker"))
    {
        @* Off in Development: a cached service worker can keep stale files and make the page hang (LP-005/LP-006).
           On for the "lan" launch profile, so phones and tablets can install the app (LP-007). *@
        <script>
            if ('serviceWorker' in navigator) {
                navigator.serviceWorker.register('/service-worker.js');
            }
        </script>
    }
</body>

</html>
